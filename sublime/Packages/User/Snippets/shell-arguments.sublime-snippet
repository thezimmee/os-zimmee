<snippet>
  <content><![CDATA[
PARAMS=""
# Parsing arguments. See https://medium.com/@Drew_Stokes/bash-argument-parsing-54f3b81a6a8f
while (( "\$#" )); do
  case "\$1" in
    ${1:-a|--my-boolean-flag})
      ${2:MY_FLAG}=0
      shift
      ;;
    ${3:-b|--my-flag-with-argument}*)
      if [[ "\$1" == *"="* ]]; then
        ${4:MY_FLAG_ARG}="\${1#*=}"
        shift 1
      elif [ -n "\$2" ] && [ \${2:0:1} != "-" ]; then
        ${4:MY_FLAG_ARG}=\$2
        shift 2
      else
        echo "Error: Argument for \$1 is missing" >&2
        exit 1
      fi
      ;;
    -*|--*=) # unsupported flags
      echo "Error: Unsupported flag \$1" >&2
      exit 1
      ;;
    *) # preserve positional arguments
      PARAMS="$PARAMS \$1"
      shift
      ;;
  esac
done
# set positional arguments in their proper place
eval set -- "$PARAMS"
]]></content>
